# Copy to .env.local (Next) — scripts read .env via dotenv; `vercel env pull .env` fills both.

# Neon Postgres (Vercel Marketplace). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel Blob (original CSV/PDF files)
BLOB_READ_WRITE_TOKEN=

# AI — LangChain + LangSmith (all model calls go through lib/ai/suggest())
# Master switch. "false" must leave a fully working manual path (AC12).
AI_ENABLED=false
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional OpenAI-compatible proxy (e.g. Vercel AI Gateway)
OPENAI_BASE_URL=
AI_GATEWAY_API_KEY=
# LangSmith tracing (optional; leave off for local without a key)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kaikei

# Public base URL used in MCP deep links (app_url / source_refs)
APP_URL=http://localhost:3000
