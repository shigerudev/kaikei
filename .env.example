# Copy to .env.local (Next) — scripts read .env via dotenv; `vercel env pull .env` fills both.

# Neon Postgres (Vercel Marketplace). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel Blob (original CSV/PDF files)
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
# Master switch. "false" must leave a fully working manual path (AC12).
AI_ENABLED=false
AI_MODEL=anthropic/claude-sonnet-5-5

# Public base URL used in MCP deep links (app_url / source_refs)
APP_URL=http://localhost:3000
