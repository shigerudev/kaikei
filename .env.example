# Copy to .env at the repo root; docker compose reads it. Never commit .env.
# Every value has a working local default in docker-compose.yml.

# Postgres (internal to the compose network, no published port)
POSTGRES_USER=kaikei
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kaikei

# Object store for original uploads (SeaweedFS S3, auth required, internal network)
# S3 port is published on 127.0.0.1 only, for a host-run engine and debugging
S3_PORT=8333
S3_BUCKET=kaikei-originals
S3_ACCESS_KEY=kaikei
S3_SECRET_KEY=change-me-s3-secret
# Engine storage: STORAGE_BACKEND=s3|local (default local, no SeaweedFS needed).
# Compose sets s3 + S3_ENDPOINT_URL=http://seaweedfs:8333 for the engine.
# Host-run engine against compose: STORAGE_BACKEND=s3 S3_ENDPOINT_URL=http://127.0.0.1:8333
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=.kaikei-originals

# Sample group (Grupo AG). Idempotent; loads fixtures/grupo-ag into Postgres.
# From the engine directory, with compose Postgres reachable:
#   docker compose exec engine uv run python -m kaikei.application.seed grupo-ag /fixtures/grupo-ag
# Host (only if DATABASE_URL points at a published Postgres):
#   cd engine && uv run python -m kaikei.application.seed grupo-ag ../fixtures/grupo-ag

# Engine
# Loopback port the engine is published on (127.0.0.1 only)
ENGINE_PORT=8000
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Public origin used in MCP app_url deep links (Next)
APP_URL=http://localhost:3000
# Optional. When set, the UI and MCP call the FastAPI engine instead of lib/api/preview.
# Local compose: http://127.0.0.1:8000
# Live: https://app.kaikei.io  (Caddy already prefixes /api)
# KAIKEI_API_URL=

# MCP path token for /api/mcp/<token> (PIPER-84). Override in production.
MCP_DEMO_TOKEN=grupo-ag-mcp-demo
# Extra token=group_id pairs, comma-separated
# MCP_GROUP_TOKENS=
# Allow non-PUBLISHED runs (labelled). Default: on in preview, off when KAIKEI_API_URL is set.
# MCP_ALLOW_UNPUBLISHED=

# Optional AI (OpenRouter). Leave empty to run without a model.
OPENROUTER_API_KEY=
