# Copy to .env at the repo root; docker compose reads it. Never commit .env.
# Every value has a working local default in docker-compose.yml.

# Postgres (internal to the compose network, no published port)
POSTGRES_USER=kaikei
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kaikei

# Engine
APP_ENV=development
LOG_LEVEL=INFO
# Loopback port the engine is published on (127.0.0.1 only)
ENGINE_PORT=8000
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Optional AI (MANIFESTO §4.5). false = every flow works without a model.
AI_ENABLED=false

# UI (Next.js, host-run): where the engine API is
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
